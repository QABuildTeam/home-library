root = true

[*]
charset = utf-8
end_of_line = crlf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.{json,yml,yaml,props,csproj,slnx,xml}]
indent_size = 2

[*.cs]
max_line_length = 140

# Namespaces and usings
csharp_style_namespace_declarations = file_scoped:warning
dotnet_sort_system_directives_first = true
csharp_using_directive_placement = outside_namespace:warning

# Braces are required for all if/else bodies (CLAUDE-CODESTYLE rule 11)
csharp_prefer_braces = true:warning
dotnet_diagnostic.IDE0011.severity = warning

# Primary constructors (CLAUDE-CODESTYLE rule 4)
csharp_style_prefer_primary_constructors = true:suggestion

# Collection expressions (CLAUDE-CODESTYLE rule 16)
dotnet_style_prefer_collection_expression = when_types_loosely_match:suggestion

# var usage
csharp_style_var_for_built_in_types = true:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = true:suggestion

# Unused usings
dotnet_diagnostic.IDE0005.severity = warning

# Constants: UPPER_CASE (CLAUDE-CODESTYLE rule 6)
dotnet_naming_rule.constants_upper_case.symbols = constant_fields
dotnet_naming_rule.constants_upper_case.style = upper_case_style
dotnet_naming_rule.constants_upper_case.severity = warning
dotnet_naming_symbols.constant_fields.applicable_kinds = field, local
dotnet_naming_symbols.constant_fields.required_modifiers = const
dotnet_naming_style.upper_case_style.capitalization = all_upper
dotnet_naming_style.upper_case_style.word_separator = _

# Private fields: _camelCase
dotnet_naming_rule.private_fields_underscore.symbols = private_fields
dotnet_naming_rule.private_fields_underscore.style = underscore_camel_case
dotnet_naming_rule.private_fields_underscore.severity = suggestion
dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private
dotnet_naming_style.underscore_camel_case.capitalization = camel_case
dotnet_naming_style.underscore_camel_case.required_prefix = _
