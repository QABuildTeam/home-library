@page "/books/{id:long}"
@model DetailsModel
@{
    var book = Model.Book;
    ViewData["Title"] = book.Title;
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-page="/Index">Books</a></li>
        <li class="breadcrumb-item active" aria-current="page">@book.Title</li>
    </ol>
</nav>

<div class="d-flex justify-content-between align-items-start mb-3">
    <div>
        <h1 class="h3 mb-1">@book.Title</h1>
        <div class="text-muted">@book.Author</div>
    </div>
    <div class="text-nowrap">
        <a class="btn btn-primary" asp-page="/Books/Edit" asp-route-id="@book.Id">Edit</a>
        <a class="btn btn-outline-danger" asp-page="/Books/Delete" asp-route-id="@book.Id">Delete</a>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-4">
        <dl class="book-attributes">
            <dt>Publication year</dt>
            <dd>@(book.PublicationYear?.ToString() ?? "—")</dd>
            <dt>ISBN</dt>
            <dd>@(book.Isbn ?? "—")</dd>
            <dt>Publisher</dt>
            <dd>@(book.Publisher ?? "—")</dd>
            <dt>Pages</dt>
            <dd>@(book.PageCount?.ToString() ?? "—")</dd>
            <dt>Genre</dt>
            <dd>@(book.Genre ?? "—")</dd>
            <dt>Notes</dt>
            <dd class="text-prewrap">@(book.Notes ?? "—")</dd>
            <dt>Added</dt>
            <dd>@book.CreatedAt.ToString("yyyy-MM-dd HH:mm") UTC</dd>
            <dt>Changed</dt>
            <dd>@book.UpdatedAt.ToString("yyyy-MM-dd HH:mm") UTC</dd>
        </dl>
    </div>
    <div class="col-lg-8">
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span>Table of contents</span>
                @if (book.TableOfContentsHtml is not null)
                {
                    <a class="btn btn-sm btn-outline-secondary" asp-page-handler="ExportToc" asp-route-id="@book.Id">Download XML</a>
                }
            </div>
            <div class="card-body toc-content">
                @if (book.TableOfContentsHtml is null)
                {
                    <p class="text-muted mb-0">The table of contents is empty.</p>
                }
                else
                {
                    @* The HTML is sanitized by the converter: only structural tags without attributes are left. *@
                    @Html.Raw(book.TableOfContentsHtml)
                }
            </div>
        </div>
    </div>
</div>
