@page "/books/{id:long}/edit"
@model EditModel
@{
    ViewData["Title"] = "Edit book";
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-page="/Index">Books</a></li>
        <li class="breadcrumb-item"><a asp-page="/Books/Details" asp-route-id="@Model.Id">@Model.Input.Title</a></li>
        <li class="breadcrumb-item active" aria-current="page">Edit</li>
    </ol>
</nav>

<h1 class="h3 mb-3">Edit book</h1>

@if (Model.HasConflict)
{
    <div class="alert alert-warning">
        Your changes are kept in the form below but have not been saved.
        <a asp-page="/Books/Details" asp-route-id="@Model.Id" target="_blank">Open the current version</a>
        in a new tab to compare, then <a asp-page="/Books/Edit" asp-route-id="@Model.Id">reload the form</a> and apply your changes again.
    </div>
}

<form method="post">
    <input type="hidden" asp-for="Version" />
    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
    <partial name="_BookForm" for="Input" />

    <div class="mt-3">
        <button type="submit" class="btn btn-primary">Save</button>
        <a class="btn btn-outline-secondary" asp-page="/Books/Details" asp-route-id="@Model.Id">Cancel</a>
    </div>
</form>

@section Scripts {
    <partial name="_BookFormScripts" />
}
