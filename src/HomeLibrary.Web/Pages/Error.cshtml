@page
@model ErrorModel
@{
    ViewData["Title"] = "Error";
}

<h1 class="h3 text-danger">Something went wrong</h1>
<p>An error occurred while processing your request. Try again later.</p>

@if (Model.ShowRequestId)
{
    <p>
        <strong>Request ID:</strong> <code>@Model.RequestId</code>
    </p>
}

<a class="btn btn-primary" asp-page="/Index">Back to the list</a>
